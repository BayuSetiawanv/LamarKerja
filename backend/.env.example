# ==========================================
# APPLICATION
# ==========================================
APP_NAME=LamarKerja AI
DEBUG=True

# ==========================================
# DATABASE (PostgreSQL + pgvector di Docker)
# ==========================================
DATABASE_URL=postgresql+asyncpg://lamarkerja:secret123@localhost:5432/lamarkerja_db

# ==========================================
# REDIS (Cache & Celery broker)
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# MINIO (Object Storage untuk file PDF CV)
# ==========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=lamarkerja-files

# ==========================================
# OLLAMA (Local LLM - gratis, jalan di laptop Anda)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ==========================================
# SECURITY (JWT Authentication)
# ==========================================
SECRET_KEY=ganti-dengan-string-acak-panjang
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080