# ==========================================
# APPLICATION
# ==========================================
APP_NAME=LamarKerja AI
DEBUG=True
ENVIRONMENT=development

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql+asyncpg://lamarkerja:secret123@localhost:5432/lamarkerja_db
POSTGRES_USER=lamarkerja
POSTGRES_PASSWORD=secret123
POSTGRES_DB=lamarkerja_db
POSTGRES_PORT=5432

# ==========================================
# REDIS
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# MINIO (Object Storage)
# ==========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=lamarkerja-files

# ==========================================
# OLLAMA (Local LLM)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ==========================================
# EMBEDDING MODEL
# ==========================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==========================================
# SECURITY
# ==========================================
SECRET_KEY=change-this-to-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# FRONTEND
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
